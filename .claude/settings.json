{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just check)",
      "Bash(just test)",
      "Bash(just lint)",
      "Bash(just typecheck)",
      "Bash(just test-backend)",
      "Bash(just test-web)",
      "Bash(just dev)",
      "Bash(bash scripts/check-claude-readiness.sh)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(./credentials.json)",
      "Read(./uploads/**)",
      "Read(./media/**)",
      "Read(./data/media/**)",
      "Read(./data/uploads/**)",
      "Read(./data/audio-cache/**)",
      "Read(./data/fingerprints/**)",
      "Read(./data/waveforms/**)",
      "Read(./data/*.db)",
      "Read(./data/*.sqlite)",
      "Read(./data/*.sqlite3)",
      "Read(./*.db)",
      "Read(./*.sqlite)",
      "Read(./*.sqlite3)"
    ]
  }
}
